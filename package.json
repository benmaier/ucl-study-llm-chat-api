{
  "name": "ucl-study-llm-chat-api",
  "version": "1.0.6",
  "description": "Unified LLM chat API for Claude, OpenAI, and Gemini with code execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:watch": "vitest",
    "test:anthropic": "npx tsx src/test/test-anthropic.ts",
    "test:anthropic:debug": "npx tsx src/test/test-anthropic-debug.ts",
    "test:anthropic:upload": "npx tsx src/test/test-anthropic-file-upload.ts",
    "test:anthropic:stream": "npx tsx src/test/test-anthropic-file-upload-streaming.ts",
    "test:openai": "npx tsx src/test/test-openai.ts",
    "test:openai:upload": "npx tsx src/test/test-openai-file-upload.ts",
    "test:openai:stream": "npx tsx src/test/test-openai-file-upload-streaming.ts",
    "test:gemini": "npx tsx src/test/test-gemini.ts",
    "test:gemini:upload": "npx tsx src/test/test-gemini-file-upload.ts",
    "test:gemini:stream": "npx tsx src/test/test-gemini-file-upload-streaming.ts",
    "test:all": "npm run test:anthropic && npm run test:openai && npm run test:gemini",
    "demo:multi-turn": "npx tsx src/test/demo-multi-turn.ts",
    "test:multi-turn": "npx tsx src/test/test-multi-turn-file-access.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/genai": "^1.44.0",
    "dotenv": "^16.4.5",
    "openai": "^4.77.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
